# Copy this file to .env and edit THAT one:  make setup
#
#   .env.example  template, committed to the repository.
#                 NEVER put real values here — the token would leak into Git.
#   .env          your real configuration, ignored by Git.

# ─── Required ────────────────────────────────────────────────────────────────

# Token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your bot's handle, without the @. Used to sanity-check the token at startup.
TELEGRAM_BOT_USERNAME=my_claude_bot

# Root directory the bot may work in. /cd cannot escape it.
APPROVED_DIRECTORY=/Users/yourname/projects

# Comma-separated Telegram user IDs. Send /id to the bot to find yours.
# This is the only barrier between Telegram and a shell on this machine.
ALLOWED_USERS=123456789

# ─── Optional ────────────────────────────────────────────────────────────────

# Override the model. When unset, Claude Code's default is used.
# CLAUDE_MODEL=claude-opus-5

# Where the chat -> project/session mapping is stored.
# STATE_FILE=./data/state.json
