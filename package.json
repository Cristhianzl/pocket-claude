{
  "name": "teleclaude",
  "version": "1.0.0",
  "description": "Run Claude Code on your own machine and drive it from Telegram",
  "keywords": ["claude", "claude-code", "telegram", "bot", "agent", "anthropic"],
  "homepage": "https://github.com/cristhianzl/teleclaude#readme",
  "bugs": "https://github.com/cristhianzl/teleclaude/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristhianzl/teleclaude.git"
  },
  "license": "MIT",
  "author": "Cristhian Zanforlin Lousa <cristhian.lousa@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/**/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "dotenv": "^17.2.3",
    "grammy": "^1.39.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
